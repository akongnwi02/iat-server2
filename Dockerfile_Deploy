# ---------- Frontend build (Laravel Mix / Vue) ----------
FROM node:16-alpine AS frontend
WORKDIR /app

RUN mkdir -p /app/.npm && chown -R node:node /app/.npm
ENV NPM_CONFIG_CACHE=/app/.npm

COPY package*.json ./
RUN npm ci

COPY webpack.mix.js ./
COPY resources ./resources
COPY public ./public
#RUN npm run production


# ---------- Vendor build (Composer install with PHP 7.4) ----------
FROM php:7.4-cli-bullseye AS vendor
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    libzip-dev \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install gd zip \
 && rm -rf /var/lib/apt/lists/*

# Composer binary
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy composer files first (better cache)
COPY composer.json composer.lock ./

# IMPORTANT: composer in Laravel may scan classmaps and/or run scripts that need these present
COPY artisan ./artisan
COPY bootstrap ./bootstrap
COPY app ./app
COPY config ./config
COPY database ./database
COPY routes ./routes

# If you still get issues due to scripts/env, switch to --no-scripts (see note below)
RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    --no-progress \
    --optimize-autoloader


# ---------- Runtime (PHP-FPM + Nginx) ----------
FROM php:7.4-fpm-bullseye AS runtime
WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    unzip \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    libzip-dev \
    libpq-dev \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install pdo_mysql mysqli gd zip pdo_pgsql pgsql \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && rm -rf /var/lib/apt/lists/*

# Log to stdout/stderr (Cloud Run)
RUN ln -sf /dev/stdout /var/log/nginx/access.log \
 && ln -sf /dev/stderr /var/log/nginx/error.log

# Copy the full app
COPY . /var/www

# Bring in vendor + built frontend
COPY --from=vendor /app/vendor /var/www/vendor
COPY --from=frontend /app/public /var/www/public

# Cloud Run port
ENV PORT=8080

# Nginx config
COPY ./docker/core/nginx.conf /etc/nginx/nginx.conf
COPY ./docker/core/sites/default.conf /etc/nginx/conf.d/default.conf

# PHP Fpm config
COPY ./docker/core/php/php.ini /usr/local/etc/php/php.ini
COPY ./docker/core/php/www.conf /usr/local/etc/php-fpm.d/www.conf
COPY ./docker/core/php/php-fpm.conf /usr/local/etc/php-fpm.conf

# Ensure Laravel writable directories exist and are writable
RUN mkdir -p \
    /var/www/storage \
    /var/www/storage/app \
    /var/www/storage/framework/cache \
    /var/www/storage/framework/sessions \
    /var/www/storage/framework/views \
    /var/www/storage/logs \
    /var/www/bootstrap/cache \
 && chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
 && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

RUN mkdir -p /var/www/bootstrap/cache /var/www/storage \
    && chown -R www-data:www-data /var/www/bootstrap/cache /var/www/storage \
    && chmod -R 775 /var/www/bootstrap/cache /var/www/storage

COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
